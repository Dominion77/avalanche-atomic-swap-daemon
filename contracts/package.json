{
  "name": "contracts",
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "deploy:echo": "hardhat run scripts/deploy.ts --network echo",
    "deploy:both": "powershell -ExecutionPolicy Bypass -File ./deploy-both.ps1",
    "deploy:fuji:ignition": "hardhat ignition deploy ./ignition/modules/Lock.ts --network fuji",
    "deploy:echo:ignition": "hardhat ignition deploy ./ignition/modules/Lock.ts --network echo",
    "verify:fuji": "hardhat verify --network fuji",
    "verify:echo": "hardhat verify --network echo",
    "test-swap": "hardhat run scripts/test-swap.ts --network fuji",
    "claim-swap": "hardhat run scripts/claim-swap.ts --network echo",
    "claim-cchain": "hardhat run scripts/claim-cchain.ts",
    "check-swap": "hardhat run scripts/check-swap.ts",
    "manual-mirror": "hardhat run scripts/manual-mirror.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "chai": "^4.5.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
